# ============================================
# AutoService - Конфигурация окружения
# ============================================

# Режим запуска приложения
# production - полная проверка токенов, безопасный режим
# debug - упрощённая авторизация для разработки
# test - заглушка для SMS, тестовый режим
APP_ENV=production

# Секретный ключ для генерации токенов (в production смени на свой)
SECRET_KEY=your-secret-key-here-change-in-production

# Хост и порт для запуска сервера
HOST=127.0.0.1
PORT=8000

# Настройки базы данных (для будущего перехода на PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/autoservice
# DATABASE_URL=sqlite:///./autoservice.db

# Логирование
LOG_LEVEL=info

# SMS-шлюз (заглушка, для реальной работы нужен API-ключ)
SMS_ENABLED=false
# SMS_API_KEY=your-sms-api-key
# SMS_SENDER=AutoService

# Фронтенд
FRONTEND_URL=http://localhost:8000