# ========== НАСТРОЙКИ ПРИЛОЖЕНИЯ ==========
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=AutoServiceSystem
APP_VERSION=1.0.0

# ========== БАЗА ДАННЫХ ==========
DATABASE_URL=postgresql://postgres:change_me@db:5432/autoservice
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ========== БЕЗОПАСНОСТЬ ==========
SECRET_KEY=change_me_in_production_generate_random_string_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== CORS ==========
BACKEND_CORS_ORIGINS=["http://localhost:8000", "http://localhost:80", "https://your-domain.com"]

# ========== ЛОГИ ==========
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ========== SMTP (для уведомлений) ==========
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@example.com
